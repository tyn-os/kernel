#!/bin/bash
# tyn-pack — package a standard Elixir Mix release into a Tyn-bootable cpio +
# boot.config that the generic 1c kernel boots. No Rust, no kernel rebuild.
#
#   mix release
#   tyn-pack _build/prod/rel/my_app -o rootfs.cpio
#   ./build-disk.sh   # (CPIO=rootfs.cpio) -> disk image -> deploy-ami.sh
#
# Design (see directions/TRACK1_PHASE2_TYNPACK.md):
#   * OTP/Elixir CORE (kernel, stdlib, compiler, sasl, elixir, logger, eex, ...)
#     comes from Tyn's BASE cpio — those beams are coupled to the ERTS inside our
#     musl beam.smp. The release's own copies are ignored (base wins for core).
#   * The user's app + non-core deps come FROM the release (release wins).
#   * .app resource files are taken from the release for the whole graph, so
#     application:ensure_all_started/1 resolves dependencies (the missing-.app
#     gap that made ensure_all_started(jason) fail in 1c).
#   * The release's bundled ERTS and OTP boot scripts are ignored — tyn_boot
#     starts applications itself.
#
# Version policy: compiling with an OLDER OTP than the runtime is safe (old .beam
# loads on newer ERTS — what 1c relied on); NEWER is not. tyn-pack fails loudly
# if the release's OTP/ERTS or Elixir exceeds Tyn's base.

set -euo pipefail

# ---- Tyn base runtime versions (the ERTS inside beam.smp) ----
BASE_ERTS_MAJOR=15          # OTP 27 -> ERTS 15.x (ERTS 15.2.7.1)
BASE_ELIXIR=1.18.3
CPIO_MAX=$((0x05000000))    # CPIO_HOME 0x15000000 -> MMAP_BASE 0x1A000000 (~80 MiB)

# Elixir/OTP CORE application names that must come from the base, never the
# release. OTP apps are discovered from the base cpio's otp/lib tree; the Elixir
# core set is fixed (stable across Elixir versions).
ELIXIR_CORE="elixir eex logger ex_unit iex mix"

die() { echo "tyn-pack: ERROR: $*" >&2; exit 1; }
note() { echo "tyn-pack: $*"; }

usage() {
  cat >&2 <<EOF
usage: tyn-pack <release_dir> -o <out.cpio> [options]
  <release_dir>          a Mix release, e.g. _build/prod/rel/my_app
  -o, --out FILE         output cpio (required)
  --base FILE            base cpio (default: src/otp-rootfs.cpio)
  --tyn-erl DIR          dir with tyn_boot.beam/serial_shell.beam/tcp_shell.beam
                         (default: src/erl)
  --app NAME             release application to start (default: release dir name)
  --port N               listener port (default: 8080)
  --plug MODULE          1c override: hand this Plug to Bandit (sets boot.config
                         {plug,MODULE} instead of {apps,[app]})
  --start-mfa 'm:f(a,b)' 1c override: {start_mfa,{m,f,[a,b]}}
  --env KEY=VAL          set an env var for runtime.exs (repeatable), e.g.
                         --env SECRET_KEY_BASE=... --env PHX_SERVER=true
EOF
  exit 2
}

# Resolve default asset paths relative to THIS script, not the caller's CWD.
# tyn-pack is normally invoked from an app's build dir (e.g. `bash ~/kernel/tyn-pack`
# run from _build/...), so CWD-relative defaults silently missed the crypto shim and
# base cpio: `src/erl/crypto.beam` didn't exist under the app dir, the `[ -f ] && cp`
# skipped it, and the release's STOCK crypto.beam stayed at the cpio root — where it
# fails to load against Tyn's Rust crypto NIF (built for the shim's function set),
# taking :crypto (and therefore :ssl) down. Script-relative defaults fix that.
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REL=""; OUT=""; BASE="$SCRIPT_DIR/src/otp-rootfs.cpio"; TYN_ERL="$SCRIPT_DIR/src/erl"; DIST_COOKIE=""
APP=""; PORT=8080; PLUG=""; START_MFA=""; ENV_VARS=""
# OTP lib dir to source core .app files (compiler/sasl/...) not bundled by an
# include_erts:false release. Defaults to the build host's system OTP.
# Where the running Erlang's OTP apps live (compiler/sasl/runtime_tools, which the
# release may omit). Auto-detect from `erl` so asdf/kerl/non-system installs work —
# hardcoding /usr/lib/erlang silently produced an empty cpio when Erlang lived
# elsewhere (e.g. ~/.asdf/installs/erlang/.../lib). Override with OTP_LIB= or --otp-lib.
OTP_LIB="${OTP_LIB:-$(erl -noshell -eval 'io:format("~s/lib",[code:root_dir()]),halt().' 2>/dev/null)}"
OTP_LIB="${OTP_LIB:-/usr/lib/erlang/lib}"
while [ $# -gt 0 ]; do
  case "$1" in
    -o|--out) OUT="$2"; shift 2;;
    --base) BASE="$2"; shift 2;;
    --tyn-erl) TYN_ERL="$2"; shift 2;;
    --otp-lib) OTP_LIB="$2"; shift 2;;
    --app) APP="$2"; shift 2;;
    --port) PORT="$2"; shift 2;;
    --plug) PLUG="$2"; shift 2;;
    --start-mfa) START_MFA="$2"; shift 2;;
    --env) ENV_VARS="$ENV_VARS
$2"; shift 2;;   # KEY=VAL, repeatable; -> boot.config {env,...} for runtime.exs
    --cookie) DIST_COOKIE="$2"; shift 2;;  # write /tyn_cookie -> kernel boots the node
                                           # DISTRIBUTED (-name n@<ip> -setcookie <it>,
                                           # EPMD-less fixed port 9100). Opt-in per image.
    -h|--help) usage;;
    -*) die "unknown option $1";;
    *) [ -z "$REL" ] && REL="$1" || die "unexpected arg $1"; shift;;
  esac
done
[ -n "$REL" ] || usage
[ -n "$OUT" ] || die "missing -o <out.cpio>"
[ -d "$REL" ] || die "release dir not found: $REL"
[ -f "$BASE" ] || die "base cpio not found: $BASE"
[ -d "$REL/lib" ] || die "$REL/lib not found — is this a Mix release?"

# ================= Step 1: version check =================
# Elixir version from the release's lib/elixir-<vsn>.
REL_ELIXIR=$(ls -d "$REL"/lib/elixir-* 2>/dev/null | head -1 | sed 's/.*elixir-//')
# ERTS version from releases/start_erl.data (first field) if present, else from
# a bundled erts-* dir; map its major to compare against the base.
REL_ERTS=""
if [ -f "$REL/releases/start_erl.data" ]; then
  REL_ERTS=$(awk '{print $1}' "$REL/releases/start_erl.data")
fi
[ -z "$REL_ERTS" ] && REL_ERTS=$(ls -d "$REL"/erts-* 2>/dev/null | head -1 | sed 's/.*erts-//')
REL_ERTS_MAJOR=${REL_ERTS%%.*}

note "release: app=$(basename "$REL")  elixir=${REL_ELIXIR:-?}  erts=${REL_ERTS:-?}"
note "base:    erts major<=$BASE_ERTS_MAJOR  elixir<=$BASE_ELIXIR"

if [ -n "$REL_ERTS_MAJOR" ] && [ "$REL_ERTS_MAJOR" -gt "$BASE_ERTS_MAJOR" ]; then
  die "release ERTS $REL_ERTS (major $REL_ERTS_MAJOR) is NEWER than Tyn's base (major $BASE_ERTS_MAJOR). Rebuild the release with OTP <= 27."
fi
if [ -n "$REL_ELIXIR" ]; then
  newest=$(printf '%s\n%s\n' "$REL_ELIXIR" "$BASE_ELIXIR" | sort -V | tail -1)
  [ "$newest" = "$BASE_ELIXIR" ] || die "release Elixir $REL_ELIXIR is NEWER than base $BASE_ELIXIR. Rebuild with Elixir <= $BASE_ELIXIR."
fi
note "version check OK (release <= base)"

# ================= Step 2: core skip-list from the base =================
BASE_LIST=$(cpio -it < "$BASE" 2>/dev/null)
# OTP core app names = otp/lib/<app>-<vsn> dirs in the base.
OTP_CORE=$(echo "$BASE_LIST" | sed -n 's#^otp/lib/\([a-z_][a-z_0-9]*\)-[0-9].*#\1#p' | sort -u)
SKIP=$(printf '%s\n%s\n' "$OTP_CORE" "$(echo "$ELIXIR_CORE" | tr ' ' '\n')" | sort -u | grep -v '^$')
note "core skip-list ($(echo "$SKIP" | wc -w | tr -d ' ') apps): $(echo $SKIP | tr '\n' ' ')"

is_skipped() { echo "$SKIP" | grep -qx "$1"; }

# ================= Step 3: staging = base + release overlay =================
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT
( cd "$STAGE" && cpio -idm --quiet < "$OLDPWD/$BASE" 2>/dev/null || cpio -idm --quiet < "$BASE" ) 2>/dev/null || \
  ( cd "$STAGE" && cpio -idm --quiet < "$(cd "$(dirname "$BASE")"; pwd)/$(basename "$BASE")" )

# Overlay the enhanced launcher + shells (base already has them; refresh so the
# module cpio carries the current tyn_boot).
for b in tyn_boot.beam serial_shell.beam tcp_shell.beam; do
  [ -f "$TYN_ERL/$b" ] && cp "$TYN_ERL/$b" "$STAGE/$b"
done

# Copy ALL release .app files (whole dep graph -> ensure_all_started resolves).
# already-loaded OTP apps (kernel/stdlib) reject a second load harmlessly.
napp=0; nbeam_apps=0
CRYPTO_APPS=""
for ebin in "$REL"/lib/*/ebin; do
  [ -d "$ebin" ] || continue
  appdir=$(basename "$(dirname "$ebin")")   # <app>-<vsn>
  app=${appdir%-*}
  # .app files always
  for f in "$ebin"/*.app; do
    [ -e "$f" ] || continue
    cp "$f" "$STAGE/"; napp=$((napp+1))
    # crypto/ssl dependency scan
    if grep -qE '(^|[^a-z_])(crypto|ssl)([^a-z_]|$)' "$f" 2>/dev/null; then
      CRYPTO_APPS="$CRYPTO_APPS $app"
    fi
  done
  # beams: only for NON-core apps (release wins for everything but core)
  if is_skipped "$app"; then continue; fi
  cp "$ebin"/*.beam "$STAGE/" 2>/dev/null && nbeam_apps=$((nbeam_apps+1)) || true
done
note "overlaid: $napp .app files; beams from $nbeam_apps non-core release apps"

# ============ Step 3c: release layout for app_dir/priv (Part B) ============
# Application.app_dir(App,"priv/...") -> code:lib_dir(App) needs each app at
# lib/<app>-<vsn>/ebin ON THE CODE PATH with priv/ alongside; a flat cpio has no
# such dir, so static-asset (and LiveView-behind-it) handlers fail. Emit the
# nested layout (ebin/<app>.app + priv/**) for every non-core app. The beams keep
# loading from the flat root — nothing is duplicated but the tiny .app files and
# each app's priv/. tyn_boot code:add_pathz's these ebin dirs before app start
# (see the {code_paths,...} written into boot.config below).
CODE_PATHS=""
nlibs=0; npriv=0
for ebin in "$REL"/lib/*/ebin; do
  [ -d "$ebin" ] || continue
  appdir=$(basename "$(dirname "$ebin")")   # <app>-<vsn>
  app=${appdir%-*}
  is_skipped "$app" && continue
  mkdir -p "$STAGE/lib/$appdir/ebin"
  cp "$ebin"/*.app "$STAGE/lib/$appdir/ebin/" 2>/dev/null || true
  if [ -d "$REL/lib/$appdir/priv" ]; then
    cp -a "$REL/lib/$appdir/priv" "$STAGE/lib/$appdir/"
    npriv=$((npriv+1))
  fi
  CODE_PATHS="$CODE_PATHS lib/$appdir/ebin"
  nlibs=$((nlibs+1))
done
note "release layout: $nlibs apps -> lib/<app>-<vsn>/ebin/.app ($npriv with priv/)"

# ================= Step 3b: Phoenix / crypto enablement =================
# What makes mainstream Phoenix ({apps,[my_app]}) boot on Tyn:
#  - the Tyn crypto shim (crypto.beam + crypto.app) — the Rust crypto NIF is in
#    beam.smp; :crypto works (SHA/HMAC/AES-GCM/PBKDF2/strong_rand_bytes).
#  - the release's sys.config (app env: e.g. the Endpoint's port/secret_key_base);
#    tyn_boot application:set_env's it before ensure_all_started.
#  - stub library .app for ssl/public_key/asn1 (TLS/X.509 — Tyn terminates TLS at
#    the load balancer, not in-guest), so the dependency graph resolves without
#    real ssl beams. HTTP never calls them.
#  - OTP-core library .app files (compiler/sasl/runtime_tools) that an
#    include_erts:false release doesn't bundle and the base cpio lacks.
for b in crypto.beam crypto.app; do
  [ -f "$TYN_ERL/$b" ] && cp "$TYN_ERL/$b" "$STAGE/$b"
done
# Dist opt-in: a `tyn_cookie` file at the cpio root makes the kernel boot the node
# distributed (n@<dhcp-ip>, that cookie, EPMD-less on port 9100). Per-image and
# per-deployment — the committable replacement for the old hardcoded kernel cookie.
if [ -n "$DIST_COOKIE" ]; then
  printf '%s' "$DIST_COOKIE" > "$STAGE/tyn_cookie"
  note "tyn_cookie -> cpio root (node boots DISTRIBUTED; needs tyn_epmd in the app ebin)"
fi

SYSCFG=$(find "$REL/releases" -name sys.config 2>/dev/null | head -1)
[ -n "$SYSCFG" ] && cp "$SYSCFG" "$STAGE/sys.config" && note "sys.config -> cpio root"
# Part C: ship runtime.exs so tyn_boot can evaluate it on boot (secret_key_base,
# Endpoint port/host, ...). A stock app keeps its runtime config here; no hand-edit.
RUNTIME=$(find "$REL/releases" -name runtime.exs 2>/dev/null | head -1)
[ -n "$RUNTIME" ] && cp "$RUNTIME" "$STAGE/runtime.exs" && note "runtime.exs -> cpio root"
# Warn loudly if the release configures HTTPS/TLS: :ssl is a STUB on Tyn, so an
# https listener starts cleanly then fails with :undef at request time. Silent
# success + mysterious runtime failure is worse than an up-front error.
if [ -n "$SYSCFG" ] && grep -qE '\{https,|[,[]https[],]' "$SYSCFG" 2>/dev/null; then
  echo "tyn-pack: WARNING: the release configures HTTPS/TLS (an :https key in the" >&2
  echo "tyn-pack:          Endpoint config). Tyn has NO in-guest TLS — ssl/public_key/asn1" >&2
  echo "tyn-pack:          are STUBS, so an https listener starts cleanly then fails with" >&2
  echo "tyn-pack:          :undef at request time. Terminate TLS at the load balancer and" >&2
  echo "tyn-pack:          serve plain HTTP (scheme: http) in-guest." >&2
fi
for app in ssl public_key asn1; do
  printf '%s' "{application, $app, [{description,\"stub (Tyn: TLS/X.509 at the load balancer)\"},{vsn,\"1.0\"},{modules,[]},{registered,[]},{applications,[kernel,stdlib]}]}." > "$STAGE/$app.app"
done
for app in compiler sasl runtime_tools; do
  f=$(ls "$OTP_LIB"/${app}-*/ebin/${app}.app 2>/dev/null | head -1)
  [ -n "$f" ] && cp "$f" "$STAGE/"
done
note "enabled crypto shim + stub ssl/public_key/asn1 + OTP-core .app"

# ================= Step 4: crypto/ssl note =================
# :crypto is now provided by the Tyn shim; only :ssl (TLS) is stubbed.
CRYPTO_APPS=$(echo "$CRYPTO_APPS" | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' ')
if [ -n "${CRYPTO_APPS// /}" ]; then
  echo "tyn-pack: NOTE: $CRYPTO_APPS use :crypto/:ssl." >&2
  echo "tyn-pack:       :crypto works via Tyn's Rust NIF shim (SHA/HMAC/AES-GCM/PBKDF2)." >&2
  echo "tyn-pack:       :ssl is stubbed — TLS is terminated at the load balancer, not" >&2
  echo "tyn-pack:       in-guest, so serve plain HTTP (scheme: http) behind it." >&2
fi

# ================= Step 5: boot.config =================
[ -n "$APP" ] || APP=$(basename "$REL")
BC="$STAGE/boot.config"
{
  echo "%% generated by tyn-pack for release '$APP'"
  if [ -n "$START_MFA" ]; then
    # 'mod:fun(a,b)' -> {start_mfa,{mod,fun,[a,b]}}
    m=${START_MFA%%:*}; rest=${START_MFA#*:}; f=${rest%%(*}
    args=${rest#*(}; args=${args%)}
    echo "{start_mfa, {$m, $f, [$args]}}."
    echo "{port, $PORT}."
  elif [ -n "$PLUG" ]; then
    echo "{apps, []}."
    echo "{plug, $PLUG}."
    echo "{port, $PORT}."
  else
    echo "{apps, [$APP]}."
    echo "{port, $PORT}."
  fi
  # Part B: code paths for the nested release layout, so tyn_boot puts each
  # lib/<app>-<vsn>/ebin on the path before ensure_all_started (code:lib_dir).
  if [ -n "${CODE_PATHS// /}" ]; then
    printf '{code_paths, ['
    first=1
    for p in $CODE_PATHS; do
      [ "$first" = 1 ] && first=0 || printf ', '
      printf '"%s"' "$p"
    done
    printf ']}.\n'
  fi
  # Part C: env vars for runtime.exs. tyn_boot os:putenv's these BEFORE evaluating
  # runtime.exs, so System.get_env("SECRET_KEY_BASE") etc. resolve without a recompile.
  if [ -n "$(printf '%s' "$ENV_VARS" | tr -d '[:space:]')" ]; then
    printf '{env, ['
    first=1
    printf '%s\n' "$ENV_VARS" | while IFS= read -r kv; do
      [ -z "$kv" ] && continue
      k=${kv%%=*}; v=${kv#*=}
      [ "$first" = 1 ] && first=0 || printf ', '
      printf '{"%s", "%s"}' "$k" "$v"
    done
    printf ']}.\n'
  fi
} > "$BC"
note "boot.config:"; sed 's/^/    /' "$BC" >&2

# ================= Step 6: deterministic order-preserving pack =================
# Ordering rule (load-bearing — 1c found find(1)'s arbitrary order tickled the
# cold-boot code-loader flake): BASE entries keep their exact original cpio order
# (preserving the proven core layout; overwritten dep beams get release content
# at the same position), then NEW entries (release beams/.app + boot.config not
# present in the base) in LC_ALL=C sorted order.
BASE_ORDER=$(echo "$BASE_LIST" | grep -v '^TRAILER!!!$' || true)
( cd "$STAGE"
  # staging FILES only, base-relative. The base cpio carries no directory
  # entries (the kernel VFS matches by full path); adding find(1)'s directory
  # entries as new members would create 0-byte `otp/lib` etc. files that make
  # code_server open a "directory" and crash with {badmatch,error}.
  find . -type f | sed 's#^\./##' | LC_ALL=C sort > /tmp/tp_all.$$
)
echo "$BASE_ORDER" > /tmp/tp_base.$$
# new = staging entries not in base order, sorted
LC_ALL=C sort /tmp/tp_base.$$ > /tmp/tp_base_sorted.$$
comm -23 /tmp/tp_all.$$ /tmp/tp_base_sorted.$$ > /tmp/tp_new.$$
ORDER=$(cat <(echo "$BASE_ORDER") /tmp/tp_new.$$)
rm -f /tmp/tp_all.$$ /tmp/tp_base.$$ /tmp/tp_base_sorted.$$ /tmp/tp_new.$$

OUT_ABS=$(cd "$(dirname "$OUT")"; pwd)/$(basename "$OUT")
( cd "$STAGE" && echo "$ORDER" | cpio -o -H newc --quiet > "$OUT_ABS" )

# ================= Step 7: size-ceiling check =================
SZ=$(stat -c%s "$OUT_ABS" 2>/dev/null || stat -f%z "$OUT_ABS")
HEAD=$((CPIO_MAX - SZ))
note "packed $OUT_ABS: $SZ bytes ($(( SZ/1024/1024 )) MiB), ceiling $CPIO_MAX (~80 MiB), headroom $HEAD bytes ($(( HEAD/1024/1024 )) MiB)"
if [ "$SZ" -gt "$CPIO_MAX" ]; then
  rm -f "$OUT_ABS"
  die "packed cpio ($SZ) exceeds the ~80 MiB ceiling ($CPIO_MAX). The mmap region (CPIO_HOME->MMAP_BASE) would be corrupted. Shrink the app or revisit the kernel memory map."
fi
note "done."
